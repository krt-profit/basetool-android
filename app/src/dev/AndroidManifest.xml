<?xml version="1.0" encoding="utf-8"?>
<!--
  dev-flavor additions.

  The component showcase gets its own launcher entry so the design system can be checked on a
  device without going through the app shell. It exists only in the dev flavor — a release build
  ships no development surfaces.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".ShowcaseActivity"
            android:exported="true"
            android:label="@string/showcase_name"
            android:theme="@style/Theme.Basetool">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The dev realm's redirect. A custom scheme is claimable by any installed app, which is why
          it is registered on this realm only — PKCE stops a stolen code from being redeemed, but
          the phishing/confusion surface is free to close in production and is (security concept
          section 3).

          Scheme only, no path: Android ignores android:path when no android:host is given, so a
          path here would look like a tightening and be none. The post-logout return
          (de.kartell.basetool:/logout) therefore lands here too — it carries no code, is read as an
          unusable redirect, and simply brings the app forward, which is what it should do.
        -->
        <!--
          The login screen on a device, before anything is wired to it. Compose previews render the
          tree; they do not answer what it is like at 412 dp with the system bars in place.
        -->
        <activity
            android:name=".LoginPreviewActivity"
            android:exported="true"
            android:label="@string/login_preview_name"
            android:theme="@style/Theme.Basetool">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".auth.AuthRedirectActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="de.kartell.basetool" />
            </intent-filter>
        </activity>
    </application>

</manifest>
