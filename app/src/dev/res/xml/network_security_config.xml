<?xml version="1.0" encoding="utf-8"?>
<!--
  dev flavour only. Replaces the strict file in the main source set.

  The local test stack's Keycloak runs `start-dev` on plain HTTP. The emulator reaches it over
  `adb reverse tcp:18080 tcp:18080`, i.e. through the device's own loopback, so cleartext is
  permitted to localhost and to 10.0.2.2 (the documented host route, kept for a stack published
  without adb reverse) and to nothing else. The base config stays closed, so a dev build talking to
  any other server still refuses cleartext.

  This file does not exist in the prod flavour, so a release build structurally cannot carry the
  exception — that is the point of putting it in a source set rather than behind a build flag.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
