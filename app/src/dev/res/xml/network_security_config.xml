<?xml version="1.0" encoding="utf-8"?>
<!--
  dev flavour only. Replaces the strict file in the main source set.

  The local test stack's Keycloak runs `start-dev` on plain HTTP (127.0.0.1:18080), which the
  emulator reaches as 10.0.2.2. Cleartext is therefore permitted to that host and to nothing else:
  the base config stays closed, so a dev build that talks to any other server still refuses
  cleartext.

  This file does not exist in the prod flavour, so a release build structurally cannot carry the
  exception — that is the point of putting it in a source set rather than behind a build flag.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
