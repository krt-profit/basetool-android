<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup / device-transfer rules for Android 12 (API 31) and higher.
  Exclusions must be repeated in BOTH sections: cloud-backup rules do not cover
  device-to-device transfer, and allowBackup=false alone does not reliably stop
  a D2D transfer (docs/ANDROID_APP_SECURITY.md section 4, REQ-APP-AUTH-004).

  The paths must stay byte-identical to AuthDataStore.RELATIVE_PATH and
  ActiveOrgUnitStore.BACKUP_PATH — see BackupExclusionTest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/krt_tokens.preferences_pb" />
        <exclude domain="sharedpref" path="krt_active_org_unit.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/krt_tokens.preferences_pb" />
        <exclude domain="sharedpref" path="krt_active_org_unit.xml" />
    </device-transfer>
</data-extraction-rules>
