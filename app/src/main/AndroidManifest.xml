<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Reads whether a network exists at all, for one rule: offline DISABLES writes rather than
      queueing them (design ch. 14 — the optimistic-locking contract makes a queued mutation a
      conflict factory). Normal permission, granted at install, no runtime prompt, and nothing
      leaves the device: the callback reports the local link. Owner decision 2026-08-23; the
      plan's permission inventory and the TDDDG analysis carry it.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BasetoolApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Basetool">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Basetool"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              In-app deep links (basetool://…). Notifications and internal links resolve to the
              same routes the navigation graph declares, so every screen has exactly one address.
              Verified https App Links for the web domain follow once the server publishes
              assetlinks.json (see docs/ANDROID_APP_SECURITY.md).
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="basetool" />
            </intent-filter>
        </activity>

        <!--
          Receives the browser's redirect at the end of a login. The intent filter that matches it
          lives in the flavour manifests, because the two realms register different redirect URIs:
          a verified App Link in production, a custom scheme on the dev realm only.

          singleTask because the Custom Tab sits on top of this task while the login runs — a
          singleTop activity would be created a second time on top of the browser instead of
          returning to the app. Translucent and with no layout, so nothing flashes between the
          browser closing and the app appearing.
        -->
        <!--
          Opts AppCompat's per-app language backport into persisting the choice itself
          (ADR-0007). Without this metadata `AppCompatDelegate.setApplicationLocales` applies the
          language for the current process only on API 30-32 and the app reverts to the device
          language on the next cold start, which reads as the setting not having been saved. On
          API 33+ the platform stores it and this declaration is inert.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".auth.AuthRedirectActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>

</manifest>
