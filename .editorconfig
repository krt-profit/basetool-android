root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120

# @Composable functions are PascalCase by Compose convention; the standard ktlint rule
# would rename half the design system.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Splitting `libs.versions.foo.get().toInt()` across four lines hurts more than it helps
# in build scripts, and Compose modifier chains are already broken up by hand.
ktlint_standard_chain-method-continuation = disabled

# Compose previews and component families group many small functions per file.
ktlint_standard_function-signature = disabled

[*.{xml,yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
